{
  "name": "dungeon-duo",
  "version": "1.0.0",
  "private": true,
  "description": "A two-player cooperative browser dungeon crawler",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:3d": "esbuild src3d/view3d.src.js --bundle --minify --format=esm --outfile=public/view3d.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "three": "^0.187.0"
  }
}
